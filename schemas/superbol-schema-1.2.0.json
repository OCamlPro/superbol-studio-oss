{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://get-superbol.com/superbol-schema-1.2.0.json",
    "title": "Schema for superbol.toml files",
    "description": "Configuration file for SuperBOL Studio",
    "type": "object",
    "properties": {
        "cobol": {
            "type": "object",
            "required": [
                "dialect",
                "source-format"
            ],
            "properties": {
                "dialect": {
                    "description": "Default COBOL dialect; default is equivalent to gnucobol. The available dialects are default, gnucobol, cobol85, cobol2002, cobol2014, acu, acu-strict, bs2000, bs2000-strict, gcos, gcos-strict, ibm, ibm-strict, mf, mf-strict, mvs, mvs-strict, realia, realia-strict, rm, rm-strict, xopen. The -strict version of a dialect permits using reserved words from all other dialects as custom COBOL words, as the non-strict version also reserve these words. You may also specify an absolute path to a custom GnuCOBOL dialect configuration file (see cobc's -conf option).",
                    "type": "string"
                },
                "source-format": {
                    "description": "Source reference format.",
                    "$ref": "#/$defs/source-format"
                },
                "source-format-by-extension": {
                    "type": "array",
                    "description": "Per-extension source reference-format overrides, which take precedence over the default source-format",
                    "items": {
                        "type": "object",
                        "required": [
                            "extension",
                            "source-format"
                        ],
                        "properties": {
                            "extension": {
                                "description": "Filename extension, without the leading dot (compared regardless of case)",
                                "type": "string"
                            },
                            "source-format": {
                                "description": "Source reference format for files with this extension",
                                "$ref": "#/$defs/source-format"
                            }
                        }
                    }
                },
                "copybooks": {
                    "type": "array",
                    "description": "List of copybooks paths",
                    "items": {
                        "type": "object",
                        "required": [
                            "dir"
                        ],
                        "properties": {
                            "dir": {
                                "description": "Path to copybooks",
                                "type": "string"
                            },
                            "file-relative": {
                                "type": "boolean"
                            }
                        }
                    }
                },
                "copyexts": {
                    "type": "array",
                    "description": "File extensions for copybook resolution",
                    "items": {
                        "type": "string"
                    }
                },
                "exclude-dirs": {
                    "type": "array",
                    "description": "Directories that hold no source file to consider in project-wide operations (e.g. workspace symbols): names of directories, that match at any depth, or paths relative to the project root (entries that contain a '/'). Replaces the default, which is [\"_build\", \"_opam\", \"node_modules\"].",
                    "items": {
                        "type": "string"
                    }
                }
            }
        }
    },
    "$defs": {
        "source-format": {
            "enum": [
                "auto",
                "fixed",
                "free",
                "cobol85",
                "variable",
                "xopen",
                "xcard",
                "crt",
                "terminal",
                "cobolx"
            ]
        }
    }
}
