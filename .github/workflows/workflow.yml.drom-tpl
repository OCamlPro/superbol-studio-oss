name: Main Workflow

# use fields.git-main-branch to change from master
on:
  pull_request:
    branches:
      - !(git-main-branch:default:master)
  push:
    branches:
      - !(git-main-branch:default:master)
  # manual run in actions tab - for all branches
  workflow_dispatch:

# Cancel runs upon PR updates:
concurrency:
  group: ci-${{ github.ref }}
  cancel-in-progress: ${{ github.ref != 'refs/heads/master' }}

jobs:
  build:
    strategy:
      fail-fast: false
      matrix:
        os:
          - !{ci-systems}
        ocaml-compiler:
          - !{edition}
        # What a job builds and tests:
        # - native: native LSP server, platform-specific VSIX, native tests
        #   and debugger tests;
        # - js: universal VSIX, and tests of the LSP server compiled into
        #   JavaScript;
        # - build: only the native build, without tests.
        focus:
          - native
        include:
          - os: !{ci-first-system}
            ocaml-compiler: !{edition}
            focus: js
![if:min-edition]
          - os: !{ci-first-system}
            ocaml-compiler: !{min-edition}
            focus: build
![fi]

    runs-on: ${{ matrix.os }}

    # use fields.github-workflow-env to add something here
!(github-worlflow-env)
    steps:
      - name: Checkout code
        uses: actions/checkout@v6

      - name: Set git user
        run: |
          git config --global user.name github-actions
          git config --global user.email github-actions-bot@users.noreply.github.com

      - name: Run apt update
        if: matrix.os == 'ubuntu-latest'
        run: sudo apt update

      - name: Use OCaml ${{ matrix.ocaml-compiler }}
        uses: avsm/setup-ocaml@v3
        with:
          ocaml-compiler: ${{ matrix.ocaml-compiler }}
          opam-pin: false

      - name: Retrieve cache of local opam switch
        uses: actions/cache/restore@v5
        id: cache-opam
        with:
          path: _opam
          key: v5-${{ runner.os }}-${{ matrix.ocaml-compiler }}-!{name}-${{ hashFiles('**/*.opam', '.github/workflows/workflow.yml') }}-deps=${{ matrix.focus == 'build' && 'build' || 'dev' }}-repo=!(opam-repo)

      # use fields.opam-repo = "git+https://" to add an 'extra' opam repository
![if:field:opam-repo]
      - run: |
         opam repo add extra !(opam-repo)
         sudo apt-get update

![fi]
      # Use fields.github-workflow-before-build to add something here
!(github-workflow-before-opam)
      - run: make build-deps
        id: build-deps
        if: ${{ steps.cache-opam.outputs.cache-hit != 'true' && matrix.focus == 'build' }}

      - run: make dev-deps
        id: dev-deps
        if: ${{ steps.cache-opam.outputs.cache-hit != 'true' && matrix.focus != 'build' }}

      # Use fields.build-scripts to add more scripts to convert here
      - run: dos2unix scripts/*.sh !(build-scripts)
        if: matrix.os == 'windows-latest'

      # Use fields.github-workflow-before-build to add something here
!(github-workflow-before-build)
      - run: make build
        if: matrix.focus != 'js'

      # Use fields.github-workflow-after-build to add something here
!(github-workflow-after-build)
      - run: make test
        if: matrix.focus == 'native'

      # Use fields.github-workflow-after-test to add something here
!(github-workflow-after-test)
      # - name: Check whether source is well formatted
      #   run: make fmt
      #   continue-on-error: true
      #   if: matrix.ocaml-compiler == '!{edition}' && matrix.os == '!{ci-first-system}' && matrix.focus == 'native'

      - name: Build documentation
        if: github.ref == 'refs/heads/!(git-main-branch:default:master)' && matrix.ocaml-compiler == '!{edition}' && matrix.os == '!{ci-first-system}' && matrix.focus == 'native'
        run: |
             sudo apt install -yqq python3-sphinx python3-sphinx-rtd-theme
             opam install -y dune odoc
             make doc
             touch _drom/docs/.nojekyll
             touch _drom/docs/!{sphinx-target}/.nojekyll
             touch _drom/docs/!{odoc-target}/.nojekyll

      - name: Deploy documentation
        uses: JamesIves/github-pages-deploy-action@3.6.2
        if: github.ref == 'refs/heads/!(git-main-branch:default:master)' && matrix.ocaml-compiler == '!{edition}' && matrix.os == '!{ci-first-system}' && matrix.focus == 'native'
        with:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
          BRANCH: gh-pages
          FOLDER: _drom/docs/
          CLEAN: true

# Use fields.github-workflow-trailer to add a trailer here
!(github-workflow-trailer)

      - name: Cleanup local opam switch before caching
        run: |
          opam pin remove . --yes || true
          opam clean --switch-cleanup --logs
          find _opam -type f -a \( -name '*.cmt' -o -name '*.cmti' \) -delete
        # Even when a later step failed, as long as dependencies are installed
        if: ${{ always() && steps.cache-opam.outputs.cache-hit != 'true' && (steps.build-deps.outcome == 'success' || steps.dev-deps.outcome == 'success') }}

      - name: Save cache of local opam switch
        uses: actions/cache/save@v5
        with:
          path: _opam
          key: ${{ steps.cache-opam.outputs.cache-primary-key }}
        if: ${{ always() && steps.cache-opam.outputs.cache-hit != 'true' && (steps.build-deps.outcome == 'success' || steps.dev-deps.outcome == 'success') }}
