# -*- Makefile -*-
TARGET_NAME = superbol-vscode-oss

STUDIO = superbol_vscode_oss
STUDIO_SRCDIR = src/vscode/superbol-vscode-oss
GNUCOBOL_SRCDIR = import/gnucobol
SUPERBOL_LSP_PKG = lsp/superbol-free
TRAMABOL_PKG = tramabol/tramabol

GNUCOBOL4_COB_CONFIG ?= cob-config
GNUCOBOL4_COB_CONFIG_HOST ?= $(GNUCOBOL4_COB_CONFIG)
GNUCOBOL4_LIBDIR ?= $(shell $(GNUCOBOL4_COB_CONFIG_HOST) --libdir)

export GNUCOBOL4_COB_CONFIG
export GNUCOBOL4_COB_CONFIG_HOST
export GNUCOBOL4_LIBDIR

JS_OUTDIR = _out
JS_TARGETS = $(addprefix $(JS_OUTDIR)/,superbol-vscode-oss-bundle.js	\
				       superbol-vscode-gdb.js)

# Emacs lsp-mode source directory (https://github.com/emacs-lsp/lsp-mode):
# (could be a submodule)
LSP_MODE_SRCDIR ?= ../lsp-mode

MORE_OPAM_FILES := vendors/goblint-cil/goblint-cil.opam
MORE_DEV_OPAM_FILES := vendors/ANSITerminal/ANSITerminal.opam
AUTOFONCE_EXE = dune exec -- src/autofonce/autofonce/main.exe

# ---

include Makefile.vsix-rules

# ---

# js assembly

$(JS_OUTDIR)/superbol-vscode-oss-bundle.js:			\
		src/vscode/superbol-vscode-oss/bundle.js
	@mkdir -p $(dir $@);
	cp -f $< $@

$(JS_OUTDIR)/superbol-vscode-gdb.js:					\
		src/vscode/superbol-vscode-oss/gdb.js
	@mkdir -p $(dir $@);
	cp -f $< $@

# ---

# Artificially remove vendored dependencies from opam files.
.PHONY: opam-fix
opam-fix:
	sed -i opam/*.opam \
	    -e '/"goblint-cil" *{/ d' \
	    -e '/"ANSITerminal" *{/ d'

# Generates opam files for cross-compilation.  We artificially remove
# any JS-specific build dependency.  This is ok as those files are
# only there to grab external dependencies before cross-compiling.
.PHONY: opam-cross opam-cross-osx opam-cross-windows
opam-cross: opam-cross-osx opam-cross-windows
opam-cross-osx opam-cross-windows: opam-cross-%:
	rm -rf opam/$*/
	opam exec -- drom dep --cross $*
	sed -i opam/$*/*.opam \
	    -e '/"goblint-cil-$*" *{/ d' \
	    -e '/"ANSITerminal-$*" *{/ d' \
	    -e '/"js_of_ocaml-$*" *{/ d' \
	    -e '/"gen_js_api-$*" *{/ d' \
	    -e '/"promise_jsoo-$*" *{/ d' \
	    -e '/"jsonoo-$*" *{/ d'

DROM_PROJECT_ARGS ?=
.PHONY: project
project:
	opam exec -- drom project $(DROM_PROJECT_ARGS)
	$(MAKE) opam-fix opam-cross
	git add opam

# Warning: erases non-skipped user-modified files
# drom uses `git add` on the files it regenerates: we need to compare the
# git index against HEAD to check if it changes things.
.PHONY: check-project
check-project:
	$(MAKE) project DROM_PROJECT_ARGS=--force
	git update-index -q --ignore-submodules --refresh
	git diff-index HEAD --name-status --ignore-submodules

cross-osx-build-deps cross-windows-build-deps: cross-%-build-deps: build-deps
	opam install ./opam/*.opam ./opam/$*/*.opam --deps-only

# ---

# emacs-lsp:
emacs/lsp-superbol-customs.el: $(LSP_MODE_SRCDIR) package.json
	emacs --batch > "$@" \
	      --load "$(LSP_MODE_SRCDIR)/scripts/lsp-generate-settings.el" \
	      --eval "(dolist (l (lsp-generate-settings \"package.json\")) (print l))" \
	  && echo "Generated $@" 1>&2 \
	  || rm -f "$@"

# 8.0.1
# --eval "(princ (lsp-generate-settings \"package.json\" 'lsp-superbol))" \
# --eval '(princ "\n")' \

.PHONY: test-promote
test-promote: test-syntax-promote test-utf8-promote
	${DUNE} runtest --auto-promote

.PHONY: test-syntax
test-syntax: superbol-lsp-server
	\! opam exec -- $(AUTOFONCE_EXE) 2>/dev/null || \
	   opam exec -- $(AUTOFONCE_EXE) run -t syntax

.PHONY: test-syntax-promote
test-syntax-promote:
	-$(MAKE) test-syntax	# To avoid promoting past tests
	\! opam exec -- $(AUTOFONCE_EXE) 2>/dev/null || \
	   opam exec -- $(AUTOFONCE_EXE) promote -t syntax --apply

.PHONY: test-utf8
test-utf8: superbol-lsp-server
	\! opam exec -- $(AUTOFONCE_EXE) 2>/dev/null || \
	   opam exec -- $(AUTOFONCE_EXE) run -t utf8

.PHONY: test-utf8-promote
test-utf8-promote:
	-$(MAKE) test-utf8	# To avoid promoting past tests
	\! opam exec -- $(AUTOFONCE_EXE) 2>/dev/null || \
	   opam exec -- $(AUTOFONCE_EXE) promote -t utf8 --apply

# Debugger integration tests, run within VS Code against the debug
# bundle.  They need `cobc` and `cobcrun` in version 3.x, `gdb`, and a
# display: use `xvfb-run -a make test-vscode-debug` on headless
# machines.  Set `VSCODE_TEST_EXECUTABLE` to a VS Code executable, its
# command-line script (e.g. `/usr/bin/code`), or its installation
# directory, to use it instead of downloading one.
#
# Each suite that runs writes a transcript of its outcomes in
# `VSCODE_DEBUG_TRANSCRIPTS`, which is then compared with the expected
# one in `VSCODE_DEBUG_EXPECTED`.  The target fails if some expected
# behaviors fail, or some transcripts differ: use
# `make test-vscode-debug-promote` to accept the transcripts of the last
# run (only those of the suites it ran).
VSCODE_DEBUG_TRANSCRIPTS = ${DUNE_BUILD_DIR}/vscode-debug-transcripts
VSCODE_DEBUG_EXPECTED = test/vscode_debugger/expected

.PHONY: test-vscode-debug
test-vscode-debug: build-debug
	${DUNE} build ${DUNE_ARGS} test/vscode_debugger/main.bc.js \
		src/lsp/superbol-free/main.exe
	@echo -n "cobc   : "; command -v cobc
	@echo -n "cobcrun: "; command -v cobcrun
	rm -rf $(VSCODE_DEBUG_TRANSCRIPTS)
	mkdir -p $(VSCODE_DEBUG_TRANSCRIPTS)
	@status=0; \
	SUPERBOL_TEST_TRANSCRIPTS=$(abspath $(VSCODE_DEBUG_TRANSCRIPTS)) \
		node test/vscode_debugger/run.js || status=1; \
	$(MAKE) --no-print-directory test-vscode-debug-diff || status=1; \
	exit $$status

# Compares the transcripts of the last run with the expected ones.
.PHONY: test-vscode-debug-diff
test-vscode-debug-diff:
	@differ=0; \
	for output in $(VSCODE_DEBUG_TRANSCRIPTS)/*.output; do \
	  test -f "$$output" || continue; \
	  expected=$(VSCODE_DEBUG_EXPECTED)/$$(basename "$$output" .output).expected; \
	  test -f "$$expected" || expected=/dev/null; \
	  diff -u --label "$$expected" --label "$$output" \
	    "$$expected" "$$output" || differ=1; \
	done; \
	if [ $$differ -ne 0 ]; then \
	  echo "Transcripts differ: use \`make test-vscode-debug-promote' to accept them."; \
	  exit 1; \
	fi

# Replaces expected transcripts with those of the last run.
.PHONY: test-vscode-debug-promote
test-vscode-debug-promote:
	@mkdir -p $(VSCODE_DEBUG_EXPECTED)
	@for output in $(VSCODE_DEBUG_TRANSCRIPTS)/*.output; do \
	  test -f "$$output" || continue; \
	  expected=$(VSCODE_DEBUG_EXPECTED)/$$(basename "$$output" .output).expected; \
	  cmp -s "$$output" "$$expected" || { cp "$$output" "$$expected"; echo "Promoted $$expected"; }; \
	done

MASTER_REMOTE ?= origin

.PHONY: build-master
build-master:
	git checkout master
	git checkout .
	git pull $(MASTER_REMOTE) master
	git submodule update --recursive --init
	$(MAKE) build-deps
	$(MAKE) clean
	$(MAKE)

# ---

# Note we cannot transpile the TramaBOL interpreter into JS as long as
# it relies on bindigns against `libcob`.  So we do not define build
# rule in case the target is "universal".

TRAMABOL = $(basename $(notdir $(TRAMABOL_PKG)))
ifneq ($(TARGET_PLAT),universal)
  ifneq ($(HAVE_LIBCOB5),false)
    EXE_TARGETS += $(TRAMABOL)
    TRAMABOL_EXE = $(TRAMABOL)-$(TARGET_SPEC)$(DOT_EXE)
    ifeq ($(TARGET_PLAT)_$(LINKING_MODE),$(BUILD_PLAT)_static)
      TRAMABOL_BUILT = $(TRAMABOL)
    else
      TRAMABOL_BUILT = ${DUNE_BUILD_CONTEXT}/src/$(TRAMABOL_PKG)/main.exe
    endif

    .PHONY: tramabol tramabol-interpreter
    all: tramabol
    tramabol: tramabol-interpreter
    tramabol-interpreter: $(TRAMABOL_BUILT)
	$(CP) $(TRAMABOL_BUILT) $(TRAMABOL_EXE)

    $(TRAMABOL_BUILT): build

    .PHONY: test-tramabol
    test-tramabol:
	${DUNE} runtest test/tramabol

    .PHONY: test-tramabol-promote
    test-promote: test-tramabol-promote
    test-tramabol-promote:
	${DUNE} runtest test/tramabol --auto-promote

    .PHONY: clean-tramabol
    clean-execs: clean-tramabol
    clean-tramabol:
	rm -f $(TRAMABOL) $(wildcard $(TRAMABOL)-*-*)
  endif
endif

# ---

.PHONY: clean-extra-execs
clean-execs: clean-extra-execs
clean-extra-execs:
	rm -f h2mlstubs
